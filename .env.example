# Neon pooled connection string (Project → Connection Details → "Pooled connection").
# Never commit real values. Server-side only — never prefix with NEXT_PUBLIC_.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) connection used only by `npm run db:migrate`.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 32+ random bytes, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""
# Public URL of the deployed app (e.g. https://myfinance.vercel.app).
BETTER_AUTH_URL="http://localhost:3000"

# Set to "true" only while creating your own account, then set back to "false".
ALLOW_SIGNUP="false"
